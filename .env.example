# Smart Investment Planner — environment variables
#
# Copy this file to `.env` and fill in your own values. `.env` is git-ignored;
# never commit real credentials. Placeholders only in this file.
#
# Rule of thumb: ONLY the VITE_ prefixed values are compiled into the browser
# bundle. Everything else is read on the server, inside request handlers.

# ---------------------------------------------------------------- client-safe
# Backend project URL and its publishable (anon) key. These are designed to be
# public: every table is protected by Row-Level Security, so this key can only
# read or write rows the signed-in user owns.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
VITE_SUPABASE_PROJECT_ID=your_project_id

# Optional. Leave empty for the normal same-origin API (UI and API ship
# together). Set only if the API is served from another host.
VITE_API_BASE_URL=

# ---------------------------------------------------------------- server only
# Same project as above, read by server functions during SSR. Never prefixed
# with VITE_, so these never reach the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# Secret. Bypasses Row-Level Security — only needed if you add administrative
# maintenance tasks. The application does not require it to run.
SUPABASE_SERVICE_ROLE_KEY=

# Direct PostgreSQL connection string. Used only by database migration tooling
# (psql / the Supabase CLI), never by the running app.
DATABASE_URL=

# Optional plain-language explanation layer on top of the deterministic
# planner. The whole app works without it; the panel simply hides itself.
# AI_GATEWAY_URL must point at any OpenAI-compatible chat completions endpoint,
# e.g. https://api.openai.com/v1/chat/completions. Both the URL and the key are
# required for the feature to switch on; both stay server-side only.
AI_GATEWAY_API_KEY=
AI_GATEWAY_URL=
AI_GATEWAY_MODEL=gpt-4o-mini


# Optional live market-data provider. Unset means the clearly labelled built-in
# sample data set is used. Provider keys stay server-side.
MARKET_DATA_PROVIDER=sample
MARKET_DATA_API_KEY=

# ------------------------------------------------------------------- hosting
# Port the production server listens on (hosting platforms usually set this).
PORT=3000
# Build target for `npm run build`. Defaults to `node-server`, which is what
# Railway, Render, Fly, Docker or a plain VM need. Use `vercel`,
# `cloudflare-module`, etc. to target another platform.
NITRO_PRESET=node-server
